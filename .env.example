# Copy to .env and fill in. The real .env is gitignored — never commit secrets.

# Mistral API key (required) — used for embeddings and the chat models.
MISTRAL_API_KEY=

# Optional: shared secret protecting POST /rebuild. When set, callers must send it as
# the X-API-Key header. Leave empty to disable the guard (fine for local POC use).
REBUILD_TOKEN=
